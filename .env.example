# ==============================================================================
# StellarInvoice Environment Configuration
# ==============================================================================
# Copy this file to .env and configure values before starting the application.
# NEVER commit real credentials, secret keys, or production values to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Runtime Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL / Supabase / Prisma)
# ------------------------------------------------------------------------------
# For local Docker Compose setup:
# postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stellar_invoice?schema=public

# DIRECT_URL is required when using connection poolers (e.g. Supabase PgBouncer) for migrations:
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/stellar_invoice?schema=public

# Optional Docker container environment presets
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stellar_invoice
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. Authentication Mode
# ------------------------------------------------------------------------------
# Pluggable modes:
#   - "api_key"  : Default for local development without Supabase dependencies.
#   - "supabase" : Uses Supabase Auth JWT verification for production deployments.
AUTH_MODE=api_key

# Used when AUTH_MODE=api_key for local development
DEV_API_KEY=dev-secret-api-key-change-in-production

# Required if AUTH_MODE=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ------------------------------------------------------------------------------
# 4. Stellar Network Configuration
# ------------------------------------------------------------------------------
# Network: "TESTNET" or "PUBLIC"
STELLAR_NETWORK=TESTNET

# Stellar Horizon REST API URL (Testnet: https://horizon-testnet.stellar.org)
HORIZON_URL=https://horizon-testnet.stellar.org

# Stellar RPC URL (Testnet: https://soroban-testnet.stellar.org)
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Chain reader driver: "horizon" (classic SSE streaming) or "rpc" (stateless polling)
CHAIN_READER_DRIVER=horizon

# Public G... Stellar address receiving payments (NON-CUSTODIAL: NEVER STORE PRIVATE KEYS)
PLATFORM_WALLET_PUBLIC_ADDRESS=GBEXAMPLEPLATFORMWALLETADDRESSFORTESTNETPAYMENTS12345

# Known Asset Issuers (Testnet USDC issuer or custom assets)
# Testnet Circle USDC Issuer: GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
TESTNET_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# ------------------------------------------------------------------------------
# 5. Worker, Reconciler & Background Jobs
# ------------------------------------------------------------------------------
# Interval in milliseconds for the reconciler sweep (e.g. 180000 = 3 minutes)
RECONCILER_INTERVAL_MS=180000

# Invoice expiration check interval in milliseconds (e.g. 60000 = 1 minute)
EXPIRY_JOB_INTERVAL_MS=60000

# Stream reconnection backoff in milliseconds
LISTENER_RECONNECT_DELAY_MS=5000

# ------------------------------------------------------------------------------
# 6. Rate Limiting & Webhooks Security (Future Modules)
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
WEBHOOK_SECRET_HMAC=your-hmac-signing-secret

